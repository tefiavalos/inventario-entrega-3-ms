{
  "name": "inventario-ventas",
  "version": "1.1.0",
  "description": "Sistema de inventario y ventas – Unidad 3 (V&V con herramientas)",
  "private": true,
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src tests",
    "pretest": "npm run --silent build",
    "test": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"dist/src/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"dist/tests/**/*.test.js\"",
    "test:sentencias": "npm run --silent build && node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"dist/src/ventas/**\" dist/tests/ventas/calcularPrecioFinal.solo-sentencias.js",
    "auditoria:antes": "oxlint auditoria/antes",
    "auditoria:caracterizacion": "npm install --no-save lodash@4.17.15 moment@2.29.1 && tsc -p tsconfig.auditoria.json && node --test --test-reporter=spec dist/auditoria/caracterizacion.test.js",
    "metricas": "lizard -l typescript -C 10 -Eduplicate src auditoria/antes",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "oxlint": "1.85.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3"
  }
}
